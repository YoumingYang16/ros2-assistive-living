{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "command": {
      "type": "string",
      "maxLength": 2000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "goal": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "find_object"
        },
        "object_name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object_name"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "maxProperties": 20
    },
    "values": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "name",
    "steps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "step_id": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "failed",
                "found",
                "inconclusive",
                "not_found",
                "skipped",
                "succeeded",
                "timed_out"
              ]
            }
          },
          "required": [
            "step_id",
            "outcome"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "step"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,23}$"
            },
            "kind": {
              "type": "string"
            },
            "target": {
              "type": [
                "string",
                "null"
              ]
            },
            "seconds": {
              "type": [
                "number",
                "string"
              ]
            },
            "object_name": {
              "type": "string"
            },
            "timeout": {
              "type": [
                "number",
                "string"
              ]
            },
            "max_retries": {
              "type": [
                "integer",
                "string"
              ]
            },
            "condition": {
              "$ref": "#/$defs/condition"
            },
            "params": {
              "type": "object"
            },
            "on_failure": {
              "enum": [
                "abort",
                "continue"
              ]
            }
          },
          "required": [
            "type",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "repeat"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,23}$"
            },
            "count": {
              "type": [
                "integer",
                "string"
              ],
              "minimum": 1,
              "maximum": 10
            },
            "body": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "type",
            "count",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "if"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,23}$"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            },
            "then": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "else": {
              "type": "array",
              "minItems": 0,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "type",
            "condition",
            "then"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "search"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,23}$"
            },
            "locations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "object_name": {
              "type": "string"
            },
            "return_home": {
              "enum": [
                "always",
                "found",
                "never"
              ]
            },
            "continue_on": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "not_found",
                  "inconclusive"
                ]
              }
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "type",
            "locations",
            "object_name"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-limits": {
    "compiled_steps": 100,
    "nesting": 5,
    "repeat_count": 10,
    "condition_depth": 8,
    "condition_nodes": 64
  }
}
