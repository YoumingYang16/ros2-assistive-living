{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "task",
        "clarify",
        "answer"
      ]
    },
    "message": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "navigate",
                      "inspect",
                      "wait",
                      "speak",
                      "report",
                      "wait_state",
                      "capture",
                      "dock",
                      "follow",
                      "turn"
                    ]
                  },
                  "target": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "seconds": {
                    "type": "number"
                  },
                  "object_name": {
                    "type": "string"
                  },
                  "timeout": {
                    "type": "number"
                  },
                  "max_retries": {
                    "type": "integer"
                  },
                  "step_id": {
                    "type": "string"
                  },
                  "condition": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/condition"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "params": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {},
                        "required": [],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          }
                        },
                        "required": [
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "include_observations": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "title",
                          "include_observations"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120,
                            "pattern": "[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*){0,4}"
                          },
                          "operator": {
                            "type": "string",
                            "enum": [
                              "eq",
                              "ne",
                              "gt",
                              "gte",
                              "lt",
                              "lte"
                            ]
                          },
                          "value": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 200
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "poll_seconds": {
                            "type": "number",
                            "minimum": 0.02,
                            "maximum": 2
                          }
                        },
                        "required": [
                          "field",
                          "operator",
                          "value",
                          "poll_seconds"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "camera": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          },
                          "format": {
                            "type": "string",
                            "enum": [
                              "jpeg",
                              "png"
                            ]
                          }
                        },
                        "required": [
                          "camera",
                          "format"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "subject": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "duration_seconds": {
                            "type": "number",
                            "minimum": 0.1,
                            "maximum": 600
                          },
                          "distance_meters": {
                            "type": "number",
                            "minimum": 0.2,
                            "maximum": 10
                          }
                        },
                        "required": [
                          "subject",
                          "duration_seconds",
                          "distance_meters"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "angle_degrees": {
                            "type": "number",
                            "minimum": -360,
                            "maximum": 360
                          }
                        },
                        "required": [
                          "angle_degrees"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "on_failure": {
                    "type": "string",
                    "enum": [
                      "abort",
                      "continue"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "target",
                  "seconds",
                  "object_name",
                  "timeout",
                  "max_retries",
                  "step_id",
                  "condition",
                  "params",
                  "on_failure"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "summary",
            "steps"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "message",
    "options",
    "plan"
  ],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "step_id": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "failed",
                "found",
                "inconclusive",
                "not_found",
                "skipped",
                "succeeded",
                "timed_out"
              ]
            }
          },
          "required": [
            "step_id",
            "outcome"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
