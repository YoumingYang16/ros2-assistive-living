{
  "version": 1,
  "name": "参数化重复观察",
  "parameters": {
    "place": {"type": "location", "default": "meeting_room", "label": "检查地点"},
    "object": {"type": "object", "default": "水杯", "label": "目标物体"},
    "rounds": {"type": "integer", "min": 1, "max": 3, "default": 2, "label": "观察次数"}
  },
  "steps": [
    {"type": "step", "kind": "navigate", "target": "${place}"},
    {"type": "repeat", "id": "round", "count": "${rounds}", "body": [
      {"type": "step", "id": "look", "kind": "inspect", "target": "${place}", "object_name": "${object}"},
      {"type": "if", "condition": {"step_id": "look", "outcome": "found"}, "then": [
        {"type": "step", "kind": "speak", "params": {"text": "本次观察发现目标，证据已保存。"}}
      ]}
    ]},
    {"type": "step", "kind": "navigate", "target": "home"},
    {"type": "step", "kind": "report", "params": {"title": "重复观察完成"}}
  ]
}
